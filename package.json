{
  "name": "nexohub",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev --workspace=@nexohub/api",
    "dev:web": "npm run dev --workspace=@nexohub/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace=@nexohub/api",
    "db:seed": "npm run db:seed --workspace=@nexohub/api",
    "db:studio": "npm run db:studio --workspace=@nexohub/api"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
