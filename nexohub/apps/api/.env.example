# ─── Servidor ───
NODE_ENV=development
PORT=4000
# Orígenes permitidos (CORS + verificación de Origin), separados por coma
CLIENT_URLS=http://localhost:5173
# URL pública del frontend (para links de emails)
APP_URL=http://localhost:5173
# Número de proxies delante (Nginx/Cloudflare). 0 en local.
TRUST_PROXY=0

# ─── Base de datos (Laragon: root sin contraseña) ───
DATABASE_URL="mysql://root:@127.0.0.1:3306/nexohub"

# ─── Auth ───
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# true en producción (HTTPS)
COOKIE_SECURE=false
# Opcional, p.ej. .nexohub.com
COOKIE_DOMAIN=

# ─── Email (si SMTP_HOST está vacío, los emails se escriben en el log) ───
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NexoHub <no-reply@nexohub.local>"

