generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum MovieStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────── Usuarios ───────────────────────────────

model User {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  username       String   @unique @db.VarChar(20)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  /// legacy: description
  bio            String?  @db.VarChar(100)
  /// legacy: profile_image
  avatarUrl      String?  @map("avatar_url") @db.VarChar(500)
  /// id del asset en Cloudinary (para poder borrarlo)
  avatarPublicId String?  @map("avatar_public_id") @db.VarChar(255)
  isPublic       Boolean  @default(true) @map("is_public")
  role           Role     @default(USER)
  /// cache: suma de GenreReputation.points
  reputation     Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  proposedMovies  Movie[]              @relation("MovieProposer")
  moderatedMovies Movie[]              @relation("MovieModerator")
  reviews         Review[]
  responses       ReviewResponse[]
  likes           ReviewLike[]
  favorites       FavoriteMovie[]
  genreReputation GenreReputation[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]

  @@index([role])
  @@index([reputation])
  @@map("users")
}

// ─────────────────────────────── Catálogo ───────────────────────────────

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  movies     Movie[]
  reputation GenreReputation[]

  @@map("genres")
}

model Movie {
  id             Int     @id @default(autoincrement())
  title          String  @db.VarChar(255)
  /// legacy: description
  synopsis       String? @db.Text
  /// idioma de la sinopsis: 'es' o 'en' (pendiente de traducir)
  synopsisLang   String? @map("synopsis_lang") @db.VarChar(5)
  /// legacy: movie_author
  director       String? @db.VarChar(255)
  /// legacy: year
  releaseYear    Int?    @map("release_year") @db.SmallInt
  posterUrl      String? @map("poster_url") @db.VarChar(500)
  posterPublicId String? @map("poster_public_id") @db.VarChar(255)
  /// destacado manual (override del admin)
  featured       Boolean @default(false)

  genreId Int   @map("genre_id")
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  externalSource String? @map("external_source") @db.VarChar(50)
  externalId     String? @map("external_id") @db.VarChar(100)

  status          MovieStatus @default(PENDING)
  rejectionReason String?     @map("rejection_reason") @db.Text
  proposedById    Int?        @map("proposed_by_id")
  proposedBy      User?       @relation("MovieProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  moderatedById   Int?        @map("moderated_by_id")
  moderatedBy     User?       @relation("MovieModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt     DateTime?   @map("moderated_at")

  /// agregados cacheados, actualizados en la misma transacción que la reseña
  ratingAvg    Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewsCount Int     @default(0) @map("reviews_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviews   Review[]
  favorites FavoriteMovie[]

  @@unique([externalSource, externalId])
  @@index([status, genreId])
  @@index([status, ratingAvg(sort: Desc), reviewsCount(sort: Desc)])
  @@index([title])
  @@index([proposedById])
  @@index([synopsisLang])
  @@map("movies")
}

// ─────────────────────────────── Comunidad ───────────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  /// 1..5 (validado con Zod)
  rating     Int      @db.TinyInt
  /// legacy: comment
  content    String?  @db.Text
  imageUrl   String?  @map("image_url") @db.VarChar(500)
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userId  Int   @map("user_id")
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId Int   @map("movie_id")
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  responses ReviewResponse[]
  likes     ReviewLike[]

  @@unique([userId, movieId])
  @@index([movieId, createdAt(sort: Desc)])
  @@index([movieId, likesCount(sort: Desc)])
  @@map("reviews")
}

model ReviewResponse {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviewId Int    @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   Int    @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = respuesta directa a la reseña
  parentId Int?             @map("parent_id")
  parent   ReviewResponse?  @relation("ResponseThread", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children ReviewResponse[] @relation("ResponseThread")

  @@index([reviewId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("review_responses")
}

model ReviewLike {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  Int      @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, reviewId])
  @@index([reviewId])
  @@map("review_likes")
}

model FavoriteMovie {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   Int      @map("movie_id")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, movieId])
  @@index([movieId])
  @@map("favorite_movies")
}

// ─────────────────────────────── Gamificación ───────────────────────────────

/// Reputación del autor de reseñas por género.
/// points = floor(likesReceived / LIKES_PER_POINT)
model GenreReputation {
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genreId       Int      @map("genre_id")
  genre         Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)
  likesReceived Int      @default(0) @map("likes_received")
  points        Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([userId, genreId])
  @@index([genreId, points(sort: Desc)])
  @@map("genre_reputation")
}

// ─────────────────────────────── Auth / Tokens ───────────────────────────────

model RefreshToken {
  id         String    @id @default(cuid())
  /// SHA-256 (hex) del token opaco; el token en claro solo vive en la cookie
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// familia de rotación: si se reutiliza un token revocado se revoca toda la familia
  family     String    @db.VarChar(36)
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─────────────────────────────── Caché de servicios externos ───────────────────────────────

/// Respuestas de Cinemeta/TMDB guardadas con vencimiento, para no repetir pedidos lentos.
model ExternalCache {
  key       String   @id @db.VarChar(191)
  value     String   @db.LongText
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("external_cache")
}

/// Traducciones ya hechas: el mismo texto nunca se vuelve a pedir a MyMemory.
model TranslationCache {
  /// SHA-256 de "<origen>|<destino>|<texto>"
  hash       String   @id @db.Char(64)
  langPair   String   @map("lang_pair") @db.VarChar(10)
  translated String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("translation_cache")
}
