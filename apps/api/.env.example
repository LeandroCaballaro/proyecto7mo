# ─── Servidor ───
NODE_ENV=development
PORT=4000
# Orígenes permitidos (CORS + verificación de Origin), separados por coma
CLIENT_URLS=http://localhost:5173
# URL pública del frontend (para links de emails)
APP_URL=http://localhost:5173
# Número de proxies delante (Nginx/Cloudflare). 0 en local.
TRUST_PROXY=0

# ─── Base de datos (Laragon: root sin contraseña) ───
DATABASE_URL="mysql://root:@127.0.0.1:3306/nexohub"

# ─── Auth ───
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# true en producción (HTTPS)
COOKIE_SECURE=false
# Opcional, p.ej. .nexohub.com
COOKIE_DOMAIN=

# ─── Email (si SMTP_HOST está vacío, los emails se escriben en el log) ───
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NexoHub <no-reply@nexohub.local>"

# ─── Películas ───
# Sin clave se usa Cinemeta (gratis, sin registro). Opcional, TMDB (datos en español):
# API key v3 o token de lectura v4: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=es-MX
# Opcional: email para MyMemory (traducción de sinopsis sin versión en español). Sube el cupo a 50.000 caracteres/día.
TRANSLATE_EMAIL=

# ─── Importación automática (con npm run dev / start) ───
# Películas nuevas por día (0 = desactivado) y años hacia atrás que recorre.
AUTO_IMPORT_MOVIES=0
AUTO_IMPORT_YEARS=2

# ─── Seed ───
# Contraseña de las cuentas demo (admin, superadmin, carlosp, anagomez, marial)
SEED_DEMO_PASSWORD=password

# ─── Cuentas personales (npm run db:accounts) ───
# Contraseña: 8+ caracteres con mayúscula, minúscula y número.
SUPERADMIN_NAME=
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
TEST_USER_NAME=
TEST_USER_USERNAME=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
